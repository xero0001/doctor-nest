generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hospital {
  id                              String                   @id @default(cuid())
  name                            String
  slug                            String                   @unique
  translationContextEnabled       Boolean                  @default(true)
  translationContextMessageCount  Int                      @default(10)
  chatCoachContextEnabled         Boolean                  @default(true)
  chatCoachContextMessageCount    Int                      @default(10)
  autoResponseContextEnabled      Boolean                  @default(true)
  autoResponseContextMessageCount Int                      @default(10)
  autoResponseDelayMinutes        Int                      @default(5)
  introduction                    String                   @default("")
  operatingNotes                  String                   @default("")
  profileImageObjectKey           String?
  profileImageUrl                 String?
  profileImageOriginalName        String?
  profileImageContentType         String?
  profileImageSizeBytes           Int?
  users                           User[]
  authUsers                       AuthUser[]
  channelConnections              ChannelConnection[]
  channelAutoReplySettings        ChannelAutoReplySetting[]
  patients                        Patient[]
  patientTags                     PatientTag[]
  patientTagHistories             PatientTagHistory[]
  careAutomations                 CareAutomation[]
  conversations                   Conversation[]
  appointments                    Appointment[]
  manualFolders                   ManualFolder[]
  manualTags                      ManualTag[]
  manualDocuments                 ManualDocument[]
  contentEvents                   ContentEvent[]
  operatingHours                  HospitalOperatingHour[]
  chatCoachGenerations            ChatCoachGeneration[]
  autoResponseGenerations         AutoResponseGeneration[]
  accessProfiles                  HospitalAccessProfile[]
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @updatedAt
  patientChannels                 PatientChannel[]

  @@map("Organization")
}

enum HospitalWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model HospitalOperatingHour {
  id           String          @id @default(cuid())
  hospitalId   String
  weekday      HospitalWeekday
  isOpen       Boolean         @default(true)
  openMinutes  Int             @default(600)
  closeMinutes Int             @default(1140)
  hospital     Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([hospitalId, weekday])
  @@index([hospitalId, weekday])
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

model User {
  id           String    @id @default(cuid())
  hospitalId   String    @map("organizationId")
  username     String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(AGENT)
  hospital     Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([hospitalId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuthUser {
  id                      String                 @id
  name                    String
  email                   String                 @unique
  emailVerified           Boolean                @default(false)
  image                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  username                String?                @unique
  displayUsername         String?
  hospitalId              String?                @map("organizationId")
  role                    String                 @default("AGENT")
  accessProfileId         String?
  hospital                Hospital?              @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  accessProfile           HospitalAccessProfile? @relation(fields: [accessProfileId], references: [id], onDelete: SetNull)
  authsessions            AuthSession[]
  authaccounts            AuthAccount[]
  conversationAssignments ConversationAssignee[]
  patientTagHistories     PatientTagHistory[]

  @@index([hospitalId])
  @@index([accessProfileId])
}

model HospitalAccessProfile {
  id          String     @id @default(cuid())
  hospitalId  String     @map("organizationId")
  key         String
  name        String
  description String     @default("")
  permissions String[]   @default([])
  isLocked    Boolean    @default(false)
  sortOrder   Int        @default(0)
  hospital    Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  users       AuthUser[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([hospitalId, key])
  @@index([hospitalId, sortOrder])
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  authuser  AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  authuser              AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum ChatChannel {
  KAKAO
  LINE
  NAVER_TALK
  WECHAT
  WHATSAPP
  INSTAGRAM
}

enum ChannelStatus {
  DISCONNECTED
  CONFIGURING
  CONNECTED
  ERROR
}

model ChannelConnection {
  id                   String        @id @default(cuid())
  hospitalId           String        @map("organizationId")
  channel              ChatChannel
  status               ChannelStatus @default(DISCONNECTED)
  displayName          String?
  externalAccountId    String?
  credentialsEncrypted String?
  webhookToken         String        @default(cuid())
  connectedAt          DateTime?
  hospital             Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([hospitalId, channel])
  @@index([hospitalId, status])
}

model ChannelAutoReplySetting {
  id                          String      @id @default(cuid())
  hospitalId                  String      @map("organizationId")
  channel                     ChatChannel
  delayMinutes                Int         @default(1)
  businessHoursEnabled        Boolean     @default(false)
  businessHoursMessage        String      @default("")
  outsideBusinessHoursEnabled Boolean     @default(true)
  outsideBusinessHoursMessage String      @default("")
  hospital                    Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  @@unique([hospitalId, channel])
  @@index([hospitalId, channel])
}

model Patient {
  id               String                 @id @default(cuid())
  hospitalId       String                 @map("organizationId")
  chartNumber      String?                @map("externalRef")
  name             String
  phone            String?
  phoneCountryCode String                 @default("+82")
  phoneNormalized  String?
  email            String?
  gender           String?
  birthDate        DateTime?
  language         String                 @default("ko")
  visitType        String?
  nationality      String?
  marketingConsent Boolean                @default(false)
  notes            String?
  managementNotes  String?
  notesUpdatedAt   DateTime?
  legacyTags       String[]               @default([]) @map("tags")
  hospital         Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  channels         PatientChannel[]
  tagAssignments   PatientTagAssignment[]
  tagHistories     PatientTagHistory[]
  conversations    Conversation[]
  appointments     Appointment[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([hospitalId, chartNumber])
  @@index([hospitalId, name])
  @@index([hospitalId, phoneNormalized])
  @@map("Customer")
}

model PatientChannel {
  id                 String                    @id @default(cuid())
  hospitalId         String
  patientId          String?
  channel            ChatChannel
  externalCustomerId String
  displayName        String?
  phone              String?
  phoneNormalized    String?
  isPrimary          Boolean                   @default(false)
  linkMethod         PatientChannelLinkMethod?
  linkedAt           DateTime?
  hospital           Hospital                  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient            Patient?                  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  conversations      Conversation[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([hospitalId, channel, externalCustomerId])
  @@index([hospitalId, phoneNormalized])
  @@index([patientId, channel])
}

enum PatientChannelLinkMethod {
  AUTO
  MANUAL
}

enum PatientTagCategory {
  TREATMENT
  STATUS
  SOURCE
}

model PatientTag {
  id                String                 @id @default(cuid())
  hospitalId        String
  name              String
  color             String                 @default("#3157F6")
  category          PatientTagCategory     @default(TREATMENT)
  hospital          Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  assignments       PatientTagAssignment[]
  automationTargets CareAutomationTag[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([hospitalId, name])
  @@index([hospitalId, category])
}

model PatientTagAssignment {
  patientId String
  tagId     String
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tag       PatientTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([patientId, tagId])
  @@index([tagId])
}

enum PatientTagHistorySource {
  CUSTOMER_INPUT
  EXCEL_IMPORT
  CUSTOMER_DETAIL
  MIGRATION
}

model PatientTagHistory {
  id             String                  @id @default(cuid())
  hospitalId     String
  patientId      String
  tagNames       String[]                @default([])
  source         PatientTagHistorySource
  modifiedById   String?
  modifiedByName String
  hospital       Hospital                @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient        Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  modifiedBy     AuthUser?               @relation(fields: [modifiedById], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now())

  @@index([patientId, createdAt])
  @@index([hospitalId, createdAt])
  @@index([modifiedById])
}

model CareAutomation {
  id          String                  @id @default(cuid())
  hospitalId  String
  name        String
  nationality String?
  message     String                  @default("")
  isActive    Boolean                 @default(true)
  hospital    Hospital                @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  targetTags  CareAutomationTag[]
  messages    CareAutomationMessage[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([hospitalId, isActive, updatedAt])
}

model CareAutomationMessage {
  id           String         @id @default(cuid())
  automationId String
  dayOffset    Int
  title        String
  content      String
  sortOrder    Int            @default(0)
  automation   CareAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([automationId, sortOrder])
}

model CareAutomationTag {
  automationId String
  tagId        String         @unique
  automation   CareAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  tag          PatientTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([automationId, tagId])
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model Conversation {
  id                        String                   @id @default(cuid())
  hospitalId                String                   @map("organizationId")
  patientId                 String?                  @map("customerId")
  patientChannelId          String?
  channel                   ChatChannel
  externalThreadId          String?
  status                    ConversationStatus       @default(OPEN)
  important                 Boolean                  @default(false)
  autoRespondEnabled        Boolean                  @default(false)
  autoTranslateEnabled      Boolean                  @default(true)
  translationTargetLanguage String?
  unreadCount               Int                      @default(0)
  lastMessageAt             DateTime                 @default(now())
  hospital                  Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient                   Patient?                 @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientChannel            PatientChannel?          @relation(fields: [patientChannelId], references: [id], onDelete: SetNull)
  messages                  Message[]
  assignees                 ConversationAssignee[]
  chatCoachGenerations      ChatCoachGeneration[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  autoResponseGenerations   AutoResponseGeneration[]

  @@unique([hospitalId, channel, externalThreadId])
  @@index([hospitalId, status, lastMessageAt])
  @@index([patientId])
}

model ConversationAssignee {
  conversationId String
  userId         String
  assignedAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           AuthUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CUSTOMER
  STAFF
  AI
  SYSTEM
}

model Message {
  id                      String                   @id @default(cuid())
  conversationId          String
  externalMessageId       String?
  direction               MessageDirection
  sender                  MessageSender
  content                 String
  sourceLanguage          String                   @default("")
  sourceLanguageName      String                   @default("")
  translatedContent       String                   @default("")
  translatedLanguage      String                   @default("")
  translatedLanguageName  String                   @default("")
  bookmarkedAt            DateTime?
  sentAt                  DateTime                 @default(now())
  conversation            Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chatCoachGenerations    ChatCoachGeneration[]
  autoResponseGenerations AutoResponseGeneration[]

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, sentAt])
}

enum ChatCoachGenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

model ChatCoachGeneration {
  id                   String                    @id @default(cuid())
  hospitalId           String
  conversationId       String
  sourceMessageId      String
  requestedById        String?
  model                String
  status               ChatCoachGenerationStatus @default(PENDING)
  sourceSnapshot       String
  treatmentTags        String[]                  @default([])
  knowledgeDocumentIds String[]                  @default([])
  sources              Json?
  responseGuide        String?
  answerExample        String?
  inputTokens          Int?
  outputTokens         Int?
  totalTokens          Int?
  errorMessage         String?
  hospital             Hospital                  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  conversation         Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage        Message                   @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([conversationId, sourceMessageId])
  @@index([hospitalId, createdAt])
  @@index([conversationId, createdAt])
}

enum AutoResponseGenerationStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model AutoResponseGeneration {
  id                     String                       @id @default(cuid())
  hospitalId             String
  conversationId         String
  sourceMessageId        String
  model                  String
  status                 AutoResponseGenerationStatus @default(PENDING)
  sourceSnapshot         String
  contextMessageCount    Int                          @default(0)
  treatmentTags          String[]                     @default([])
  knowledgeDocumentIds   String[]                     @default([])
  sources                Json?
  generatedContent       String?
  deliveredContent       String?
  translatedLanguage     String                       @default("ko")
  translatedLanguageName String                       @default("한국어")
  externalMessageId      String?
  inputTokens            Int?
  outputTokens           Int?
  totalTokens            Int?
  attemptCount           Int                          @default(1)
  errorMessage           String?
  sentAt                 DateTime?
  hospital               Hospital                     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  conversation           Conversation                 @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage          Message                      @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  @@unique([conversationId, sourceMessageId])
  @@index([hospitalId, status, updatedAt])
  @@index([conversationId, createdAt])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id          String            @id @default(cuid())
  hospitalId  String            @map("organizationId")
  patientId   String            @map("customerId")
  scheduledAt DateTime
  doctorName  String
  treatment   String?
  status      AppointmentStatus @default(SCHEDULED)
  hospital    Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([hospitalId, scheduledAt])
  @@index([patientId, scheduledAt])
}

model ManualFolder {
  id         String           @id @default(cuid())
  hospitalId String
  parentId   String?
  name       String
  sortOrder  Int              @default(0)
  isActive   Boolean          @default(true)
  hospital   Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  parent     ManualFolder?    @relation("ManualFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   ManualFolder[]   @relation("ManualFolderTree")
  documents  ManualDocument[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([hospitalId, name])
  @@index([hospitalId, parentId, sortOrder])
}

model ManualDocument {
  id              String                @id @default(cuid())
  hospitalId      String
  folderId        String
  title           String
  slug            String
  contentMarkdown String
  cautionMarkdown String                @default("")
  cautionEnabled  Boolean               @default(false)
  isActive        Boolean               @default(true)
  sortOrder       Int                   @default(0)
  hospital        Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  folder          ManualFolder          @relation(fields: [folderId], references: [id], onDelete: Cascade)
  images          ManualDocumentImage[]
  tags            ManualDocumentTag[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([hospitalId, slug])
  @@index([folderId, sortOrder])
}

model ManualDocumentImage {
  id           String         @id @default(cuid())
  documentId   String
  objectKey    String
  publicUrl    String
  originalName String
  contentType  String
  sizeBytes    Int
  altText      String         @default("")
  sortOrder    Int            @default(0)
  document     ManualDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([documentId, objectKey])
  @@index([documentId, sortOrder])
}

model ManualTag {
  id         String              @id @default(cuid())
  hospitalId String
  name       String
  color      String              @default("#8066EC")
  hospital   Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  documents  ManualDocumentTag[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model ManualDocumentTag {
  documentId String
  tagId      String
  document   ManualDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        ManualTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@id([documentId, tagId])
  @@index([tagId])
}

enum ContentEventDetailType {
  IMAGE
  TEXT
}

enum ContentEventImageRole {
  THUMBNAIL
  DETAIL
}

model ContentEvent {
  id                String                 @id @default(cuid())
  hospitalId        String
  title             String
  summary           String                 @default("")
  originalPrice     Int                    @default(0)
  discountAmount    Int                    @default(0)
  currency          String                 @default("KRW")
  isActive          Boolean                @default(true)
  isPinned          Boolean                @default(false)
  exposureStartAt   DateTime?
  exposureEndAt     DateTime?
  detailType        ContentEventDetailType @default(IMAGE)
  detailText        String                 @default("")
  viewCount         Int                    @default(0)
  consultationCount Int                    @default(0)
  hospital          Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  images            ContentEventImage[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([hospitalId, isPinned, createdAt])
  @@index([hospitalId, isActive, exposureStartAt, exposureEndAt])
}

model ContentEventImage {
  id           String                @id @default(cuid())
  eventId      String
  role         ContentEventImageRole
  objectKey    String
  publicUrl    String
  originalName String
  contentType  String
  sizeBytes    Int
  altText      String                @default("")
  sortOrder    Int                   @default(0)
  event        ContentEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([eventId, objectKey])
  @@index([eventId, role, sortOrder])
}
